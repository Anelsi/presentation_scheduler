APP_NAME="Presentation Scheduler"
APP_ENV=local
APP_TIMEZONE=Europe/Sofia
APP_BASE_URL=http://localhost/presentation_scheduler
APP_PORT=3000
DOCKER_APP_BASE_URL=http://localhost:3000

# XAMPP/local PHP settings
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=presentation_scheduler
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Docker database settings
DOCKER_DB_HOST=db
DOCKER_DB_PORT=3306
MYSQL_PORT=3307
MYSQL_DATABASE=presentation_scheduler
MYSQL_USER=presentation_user
MYSQL_PASSWORD=presentation_password
MYSQL_ROOT_PASSWORD=root_password

# AWS S3 settings
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
